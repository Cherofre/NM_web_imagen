{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NM Image Studio",
  "version": "1.1.2",
  "identifier": "com.nmimagestudio.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run desktop:prepare",
    "frontendDist": "../../static/studio"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NM Image Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://ipc.localhost; img-src 'self' http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "backend"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OTZDNTJDMEYwRTkyQzIKUldUQ2tnNFBMTVdXcUZiTlpCemJKVkFOa1NQSzZIZC9IazRUZTBFVUlTdm1ZR09Nb3lFd0d4elgK",
      "endpoints": [
        "https://github.com/Cherofre/NM_web_imagen/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
