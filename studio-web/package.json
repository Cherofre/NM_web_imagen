{
  "name": "web-imagen-tool-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/keep-asset-fallbacks.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/build_desktop_backend.ps1",
    "test:size": "node scripts/verify-size-rules.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.9.0",
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.523.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vite": "^7.1.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.9.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "^5.9.3"
  }
}
